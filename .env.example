# PrecedentIQ Environment Configuration

# Paths
PRECEDENTIQ_DATA_DIR=data/processed
PRECEDENTIQ_CHUNKS_PATH=data/processed/chunks.jsonl
PRECEDENTIQ_JUDGMENTS_PATH=data/processed/judgments.jsonl
PRECEDENTIQ_VECTOR_CACHE_DIR=data/cache

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=precedentiq_chunks
USE_QDRANT=False

# Embedding Configuration
DENSE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM / Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60
USE_OLLAMA_FALLBACK=True

# Retrieval Parameters
DEFAULT_TOP_K=5
BM25_WEIGHT=0.5
DENSE_WEIGHT=0.5
RRF_K=60
SUPREME_COURT_WEIGHT=1.2
HIGH_COURT_WEIGHT=1.0
