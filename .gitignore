# Python environments and generated bytecode
venv/
venv312/
__pycache__/
*.py[cod]
*$py.class

# Local secrets and environment settings
.env
.env.*
!.env.example

# Downloaded and generated data (keep directory placeholders via .gitkeep)
data/raw/*
data/processed/*
data/validation/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/validation/.gitkeep

# Local Hugging Face and tool caches
.cache/
.huggingface/

# Logs and local development artifacts
*.log
.DS_Store
.vscode/settings.json

